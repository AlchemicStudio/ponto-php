{
    "name": "alchemicstudio/ponto-php",
    "description": "Implementation of the Ponto API in PHP",
    "keywords": [
        "AlchemicStudio",
        "ponto-php"
    ],
    "homepage": "https://github.com/alchemicstudio/ponto-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Sébastien Denooz",
            "email": "sebastien.denooz@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.21.1",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.1",
        "phpstan/phpstan": "^2.1",
        "spatie/ray": "^1.28",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "AlchemicStudio\\Ponto\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlchemicStudio\\Ponto\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes",
        "stan": "vendor/bin/phpstan analyse src tests --level=max"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
